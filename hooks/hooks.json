{
  "description": "세션 시작 시 카드 뽑기 운세 팝업, 첫 메시지 때 운세를 Claude에게 전달, 프롬프트 위 운세 카드 장신구",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/fortune.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${CLAUDE_PLUGIN_ROOT}/hooks/fortune_context.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "modules": ["./charm.tsx"]
}
